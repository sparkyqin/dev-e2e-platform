# ===== AI 引擎选择 =====
# auto  : 自动探测（opencode -> claude -> simulated）
# opencode | claude | simulated : 强制指定
AI_ENGINE=auto

# ===== OpenCode 引擎 =====
# 需要本机 opencode CLI ≥ v2.0（v2 API：/api/* + Basic 鉴权）
# 引擎为每个阶段作业自起临时 server（cwd=任务工作区，工作区级隔离），回合结束即整树收杀
# serve 就绪等待（冷启动宽裕；失败报错带最近输出）
OPENCODE_START_TIMEOUT=30000
# 远程直连已自管 server 时配置（会话将跑在远端 server 自己的项目目录——v2.0.x 会话绑定服务端 cwd）
# OPENCODE_KEY = 远端 server 的口令（Basic 鉴权密码；server 侧用 OPENCODE_SERVER_PASSWORD 设定）
OPENCODE_HOST=
OPENCODE_KEY=

# ===== Claude Code 引擎 =====
# Claude Code SDK 会使用内置 CLI；需要本机已完成认证或设置 ANTHROPIC_API_KEY
CLAUDE_MODEL=sonnet
# 权限模式默认 acceptEdits（可写文件、命令仍受限）——需求文本是外部输入，
# prompt injection 不应直达任意命令；如确需全放开设 bypassPermissions 并显式 CLAUDE_ALLOW_BYPASS=true
CLAUDE_PERMISSION_MODE=acceptEdits
CLAUDE_ALLOW_BYPASS=false
CLAUDE_MAX_TURNS=40

# ===== 平台运行参数 =====
PORT=8787
DATA_DIR=./data
# 无人值守安静时段（通知合并到早上），24h 制，本地时间
QUIET_HOURS_START=22:00
QUIET_HOURS_END=08:00

# ===== 安全基座（生产部署必读 README「生产部署」） =====
# 演示模式：true=免令牌切换身份/演示种子/MR 注入后门开放（开发/演示默认）
# 生产必须显式 false：demo-login 与 switch 路由消失，演示端点仅管理员可用
DEMO_MODE=true
# 会话签名密钥（留空=首启生成并持久化到 data/runtime/.auth-secret）
AUTH_SECRET=
# 反向代理做 TLS 终止后置 true（Cookie 加 Secure 标记）
COOKIE_SECURE=false
# CORS 白名单（逗号分隔；留空=同源。生产 web 与 API 同进程托管，保持留空即可）
CORS_ORIGINS=
# 全局限流（每 IP 每分钟；认证端点固定收紧 10/min）
RATE_LIMIT_PER_MIN=600
# MR 事件 webhook HMAC 签名密钥（配置后 /api/tasks/:id/mr/events 需带
# X-Signature: sha256=<hex>，签名对象 = HMAC-SHA256(secret, JSON.stringify(body))）
MR_WEBHOOK_SECRET=

# ===== 存储后端 =====
# 留空 = 文件真源（data/runtime/tasks/<id>/.flow/{state.json,events.jsonl,audit.jsonl}，单实例）
# 配置 = PG 真源（ai_tasks/ai_events/ai_audit 表，advisory lock 跨进程串行；工作区仍在文件系统）
# DATABASE_URL=postgres://user:pass@host:5432/dbname
DATABASE_SCHEMA=public
# 测试：配 TEST_DATABASE_URL 后全量 e2e 跑在 PG 后端（每实例独立 schema，双后端契约测试）
# TEST_DATABASE_URL=postgres://user:pass@host:5432/testdb
